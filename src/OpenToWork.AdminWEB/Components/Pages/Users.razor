@page "/users"
@using OpenToWork.AdminWEB.Services
@using OpenToWork.Shared.DTOs
@using OpenToWork.Shared.Enums
@using Microsoft.AspNetCore.WebUtilities
@inject LanguageService Lang
@inject LocalStorageService LocalStorage
@inject AdminAuthApiService AuthApi
@inject NavigationManager Nav
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>@Lang.T("admin.users.title")</PageTitle>

<div class="admin-page-header">
    <h1>@Lang.T("admin.users.title")</h1>
    <div class="admin-page-actions">
        @if (!string.IsNullOrEmpty(FilterLabel))
        {
            <span class="admin-filter-badge">@FilterLabel</span>
            <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="ClearFilter">@Lang.T("admin.users.clearFilter")</button>
        }
        <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="ExportCsv">@Lang.T("admin.users.exportCsv")</button>
    </div>
</div>

@if (UsersList == null)
{
    <div class="admin-loading">@Lang.T("admin.common.loading")</div>
}
else if (UsersList.Count == 0)
{
    <div class="admin-empty">
        <div class="admin-empty-icon">&#9632;</div>
        <div class="admin-empty-text">@Lang.T("admin.users.empty")</div>
    </div>
}
else
{
    <table class="ot-table">
        <thead>
            <tr>
                <th>@Lang.T("admin.users.columnEmail")</th>
                @if (ShowCandidateColumns)
                {
                    <th>@Lang.T("admin.users.columnName")</th>
                }
                <th>@Lang.T("admin.users.columnRole")</th>
                @if (FilterType == "evaluated" || FilterType == "pending")
                {
                    <th>@Lang.T("admin.users.columnEvaluated")</th>
                }
                @if (FilterType == "linkedin")
                {
                    <th>@Lang.T("admin.users.columnLinkedIn")</th>
                }
                @if (FilterType == "portfolio")
                {
                    <th>@Lang.T("admin.users.columnPortfolio")</th>
                }
                @if (FilterType == "cv")
                {
                    <th>@Lang.T("admin.users.columnCV")</th>
                }
                @if (FilterType == "scores")
                {
                    <th>@Lang.T("admin.users.columnScore")</th>
                }
                <th>@Lang.T("admin.users.columnStatus")</th>
                <th>@Lang.T("admin.users.columnCreated")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in UsersList)
            {
                <tr>
                    <td>@user.Email</td>
                    @if (ShowCandidateColumns)
                    {
                        <td>@(user.CandidateName ?? "-")</td>
                    }
                    <td>@((UserRole)user.PrimaryRole)</td>
                    @if (FilterType == "evaluated" || FilterType == "pending")
                    {
                        <td>
                            @if (user.WizardCompleted == true)
                            {
                                <span class="admin-status admin-status--active">@Lang.T("admin.users.yes")</span>
                            }
                            else
                            {
                                <span class="admin-status admin-status--inactive">@Lang.T("admin.users.no")</span>
                            }
                        </td>
                    }
                    @if (FilterType == "linkedin")
                    {
                        <td>
                            @if (user.HasLinkedIn == true)
                            {
                                <span class="admin-status admin-status--active">@Lang.T("admin.users.yes")</span>
                            }
                            else
                            {
                                <span class="admin-status admin-status--inactive">@Lang.T("admin.users.no")</span>
                            }
                        </td>
                    }
                    @if (FilterType == "portfolio")
                    {
                        <td>
                            @if (user.HasPortfolio == true)
                            {
                                <span class="admin-status admin-status--active">@Lang.T("admin.users.yes")</span>
                            }
                            else
                            {
                                <span class="admin-status admin-status--inactive">@Lang.T("admin.users.no")</span>
                            }
                        </td>
                    }
                    @if (FilterType == "cv")
                    {
                        <td>
                            @if (user.HasCV == true)
                            {
                                <span class="admin-status admin-status--active">@Lang.T("admin.users.yes")</span>
                            }
                            else
                            {
                                <span class="admin-status admin-status--inactive">@Lang.T("admin.users.no")</span>
                            }
                        </td>
                    }
                    @if (FilterType == "scores")
                    {
                        <td>
                            @if (user.HasScore == true)
                            {
                                <span class="admin-status admin-status--active">@Lang.T("admin.users.yes")</span>
                            }
                            else
                            {
                                <span class="admin-status admin-status--inactive">@Lang.T("admin.users.no")</span>
                            }
                        </td>
                    }
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="admin-status admin-status--active">@Lang.T("admin.users.active")</span>
                        }
                        else
                        {
                            <span class="admin-status admin-status--inactive">@Lang.T("admin.users.inactive")</span>
                        }
                    </td>
                    <td>@user.CreatedAt.ToLocalTime().ToShortDateString()</td>
                    <td>
                        <div class="admin-table-actions">
                            @if (user.IsActive)
                            {
                                <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="() => Deactivate(user.Id)">@Lang.T("admin.users.deactivate")</button>
                            }
                            else
                            {
                                <button class="ot-btn ot-btn--outline ot-btn--small" @onclick="() => Activate(user.Id)">@Lang.T("admin.users.activate")</button>
                            }
                            <button class="ot-btn ot-btn--danger ot-btn--small" @onclick="() => Delete(user.Id)">@Lang.T("admin.users.delete")</button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<AdminUserDto>? UsersList;
    private string? RoleFilter { get; set; }
    private string? FilterType { get; set; }
    private string? FilterLabel { get; set; }
    private bool ShowCandidateColumns => RoleFilter == "candidate" || FilterType == "evaluated" || FilterType == "pending" || FilterType == "linkedin" || FilterType == "portfolio" || FilterType == "cv" || FilterType == "scores";

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();

        var token = await LocalStorage.GetItemAsync("otwadmin-token");
        if (string.IsNullOrEmpty(token))
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        ParseQueryParams();
        await LoadUsers();
    }

    private void ParseQueryParams()
    {
        var uri = Nav.Uri;
        var query = QueryHelpers.ParseQuery(uri);
        
        if (query.TryGetValue("role", out var role))
            RoleFilter = role.ToString();
        
        if (query.TryGetValue("filter", out var filter))
            FilterType = filter.ToString();

        FilterLabel = BuildFilterLabel();
    }

    private string? BuildFilterLabel()
    {
        if (string.IsNullOrEmpty(RoleFilter) && string.IsNullOrEmpty(FilterType))
            return null;

        var parts = new List<string>();
        
        if (RoleFilter == "candidate")
            parts.Add(Lang.T("admin.users.filterCandidates"));
        else if (RoleFilter == "company")
            parts.Add(Lang.T("admin.users.filterCompanies"));

        if (FilterType == "evaluated")
            parts.Add(Lang.T("admin.dashboard.evaluated"));
        else if (FilterType == "pending")
            parts.Add(Lang.T("admin.dashboard.pending"));
        else if (FilterType == "linkedin")
            parts.Add(Lang.T("admin.dashboard.withLinkedIn"));
        else if (FilterType == "portfolio")
            parts.Add(Lang.T("admin.dashboard.withPortfolio"));
        else if (FilterType == "cv")
            parts.Add(Lang.T("admin.dashboard.withCV"));
        else if (FilterType == "scores")
            parts.Add(Lang.T("admin.dashboard.profilesWithScores"));

        return parts.Count > 0 ? string.Join(" · ", parts) : null;
    }

    private async Task LoadUsers()
    {
        var allUsers = await AuthApi.GetUsersAsync();
        
        if (!string.IsNullOrEmpty(RoleFilter))
        {
            var roleInt = RoleFilter switch
            {
                "candidate" => (int)UserRole.Candidate,
                "company" => (int)UserRole.Company,
                "admin" => (int)UserRole.Admin,
                _ => -1
            };
            allUsers = allUsers.Where(u => u.PrimaryRole == roleInt).ToList();
        }

        UsersList = allUsers;
    }

    private void ClearFilter()
    {
        Nav.NavigateTo("/users", forceLoad: true);
    }

    private async Task Activate(Guid id)
    {
        await AuthApi.ActivateUserAsync(id);
        await LoadUsers();
    }

    private async Task Deactivate(Guid id)
    {
        await AuthApi.DeactivateUserAsync(id);
        await LoadUsers();
    }

    private async Task Delete(Guid id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", Lang.T("admin.users.confirmDelete"));
        if (!confirmed) return;

        await AuthApi.DeleteUserAsync(id);
        await LoadUsers();
    }

    private async Task ExportCsv()
    {
        var bytes = await AuthApi.ExportUsersCsvAsync();
        if (bytes == null) return;

        await JS.InvokeVoidAsync("fileDownload.save", $"users-{DateTime.Now:yyyyMMddHHmmss}.csv", "text/csv", Convert.ToBase64String(bytes));
    }
}
