@page "/"
@using OpenToWork.AdminWEB.Services
@using OpenToWork.Shared.DTOs
@using OpenToWork.SharedUI.Components
@inject LanguageService Lang
@inject LocalStorageService LocalStorage
@inject AdminAuthApiService AuthApi
@inject NavigationManager Nav

<PageTitle>@Lang.T("admin.dashboard.title")</PageTitle>

@if (IsAuthenticated)
{
    <div class="admin-page-header">
        <div>
            <h1>@Lang.T("admin.dashboard.title")</h1>
            <p class="admin-page-header-subtitle">@Lang.T("admin.dashboard.welcome")</p>
        </div>
    </div>

    @if (Metrics != null)
    {
        <div class="admin-stat-grid">
            <div class="admin-stat-card admin-stat-card--success">
                <div class="admin-stat-label">@Lang.T("admin.dashboard.evaluatedProfiles")</div>
                <div class="admin-stat-value">@Metrics.EvaluatedProfiles</div>
            </div>
            <div class="admin-stat-card admin-stat-card--info">
                <div class="admin-stat-label">@Lang.T("admin.dashboard.profilesWithScores")</div>
                <div class="admin-stat-value">@Metrics.ProfilesWithScores</div>
            </div>
            <div class="admin-stat-card">
                <div class="admin-stat-label">@Lang.T("admin.dashboard.openVacancies")</div>
                <div class="admin-stat-value">@Metrics.OpenVacancies</div>
            </div>
            <div class="admin-stat-card admin-stat-card--warning">
                <div class="admin-stat-label">@Lang.T("admin.dashboard.closedVacancies")</div>
                <div class="admin-stat-value">@Metrics.ClosedVacancies</div>
            </div>
            <div class="admin-stat-card admin-stat-card--info">
                <div class="admin-stat-label">@Lang.T("admin.dashboard.companiesWithVacancies")</div>
                <div class="admin-stat-value">@Metrics.CompaniesWithVacancies</div>
            </div>
            <div class="admin-stat-card">
                <div class="admin-stat-label">@Lang.T("admin.dashboard.nonAdminUsers")</div>
                <div class="admin-stat-value">@Metrics.NonAdminUsers</div>
            </div>
            <div class="admin-stat-card admin-stat-card--success">
                <div class="admin-stat-label">@Lang.T("admin.dashboard.nonAdminCandidates")</div>
                <div class="admin-stat-value">@Metrics.NonAdminCandidates</div>
            </div>
            <div class="admin-stat-card admin-stat-card--info">
                <div class="admin-stat-label">@Lang.T("admin.dashboard.nonAdminCompanies")</div>
                <div class="admin-stat-value">@Metrics.NonAdminCompanies</div>
            </div>
        </div>
    }
    else
    {
        <div class="admin-loading">@Lang.T("admin.common.loading")</div>
    }
}

@code {
    private bool IsAuthenticated { get; set; }
    private DashboardMetricsDto? Metrics { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();

        var token = await LocalStorage.GetItemAsync("otwadmin-token");
        if (string.IsNullOrEmpty(token))
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }
        IsAuthenticated = true;

        Metrics = await AuthApi.GetMetricsAsync();
    }
}
