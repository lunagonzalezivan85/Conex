@page "/vacancies"
@using OpenToWork.Shared.DTOs
@using OpenToWork.WEB.Services
@inject ApiAuthService AuthApi
@inject LanguageService Lang

<PageTitle>@Lang.T("vacancies.title")</PageTitle>

<div class="page-container">
    <h1 class="mb-lg">@Lang.T("vacancies.title")</h1>

    <div class="search-bar">
        <input class="search-input" placeholder="@Lang.T("vacancies.searchPlaceholder")" @bind="SearchQuery" @bind:event="oninput" />
        <input class="search-input" style="max-width: 200px;" placeholder="@Lang.T("vacancies.locationPlaceholder")" @bind="SearchLocation" @bind:event="oninput" />
        <select class="search-input" style="max-width: 180px;" @bind="SearchContractType">
            <option value="">@Lang.T("common.labels.contractType")</option>
            <option value="0">@Lang.T("common.contract.fullTime")</option>
            <option value="1">@Lang.T("common.contract.partTime")</option>
            <option value="2">@Lang.T("common.contract.contract")</option>
            <option value="3">@Lang.T("common.contract.remote")</option>
        </select>
        <button class="ot-btn ot-btn--primary ot-btn--medium" @onclick="Search">@Lang.T("common.buttons.search")</button>
    </div>

    <p class="auth-subtitle mb-md">@TotalResults @Lang.T("vacancies.results")</p>

    @if (IsLoading)
    {
        <p>@Lang.T("common.labels.loading")</p>
    }
    else if (!VacancyList.Any())
    {
        <div class="ot-card text-center">
            <p class="auth-subtitle">@Lang.T("vacancies.noResults")</p>
        </div>
    }
    else
    {
        <div class="bento-grid">
            @foreach (var vacancy in VacancyList)
            {
                <div class="vacancy-card">
                    <div class="vacancy-card-title">@vacancy.Title</div>
                    <div class="vacancy-card-location">📍 @(vacancy.Location ?? "N/A")</div>
                    <div class="vacancy-card-description">@(vacancy.Description ?? "")</div>
                    <div class="vacancy-card-footer">
                        <span class="vacancy-card-salary">
                            @if (vacancy.SalaryMin.HasValue || vacancy.SalaryMax.HasValue)
                            {
                                var range = "";
                                if (vacancy.SalaryMin.HasValue) range += $"${vacancy.SalaryMin:N0}";
                                if (vacancy.SalaryMin.HasValue && vacancy.SalaryMax.HasValue) range += " - ";
                                if (vacancy.SalaryMax.HasValue) range += $"${vacancy.SalaryMax:N0}";
                                @range
                            }
                        </span>
                        <span class="vacancy-card-badge">@GetContractTypeLabel(vacancy.ContractType)</span>
                    </div>
                    <div style="margin-top: 0.5rem; font-size: 0.8rem; color: var(--text-muted);">
                        @Lang.T("vacancies.expiresIn"): @((vacancy.ExpiresAt - DateTime.UtcNow).Days) @Lang.T("vacancies.days")
                    </div>
                </div>
            }
        </div>

        @if (TotalPages > 1)
        {
            <div class="flex-center gap-sm mt-lg" style="justify-content: center;">
                @for (int i = 1; i <= TotalPages; i++)
                {
                    <button class="ot-btn @(i == CurrentPage ? "ot-btn--primary" : "ot-btn--secondary") ot-btn--small" @onclick="() => GoToPage(i)">
                        @i
                    </button>
                }
            </div>
        }
    }
</div>

@code {
    private List<TempVacancyDto> VacancyList { get; set; } = new();
    private string SearchQuery { get; set; } = "";
    private string SearchLocation { get; set; } = "";
    private string? SearchContractType { get; set; }
    private int CurrentPage { get; set; } = 1;
    private int TotalResults { get; set; }
    private int TotalPages => (int)Math.Ceiling((double)TotalResults / 10);
    private bool IsLoading { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();
        await Search();
    }

    private async Task Search()
    {
        IsLoading = true;
        CurrentPage = 1;
        await LoadVacancies();
        IsLoading = false;
    }

    private async Task GoToPage(int page)
    {
        CurrentPage = page;
        IsLoading = true;
        await LoadVacancies();
        IsLoading = false;
    }

    private async Task LoadVacancies()
    {
        var dto = new SearchVacancyDto
        {
            Query = string.IsNullOrEmpty(SearchQuery) ? null : SearchQuery,
            Location = string.IsNullOrEmpty(SearchLocation) ? null : SearchLocation,
            ContractType = int.TryParse(SearchContractType, out var ct) ? ct : null,
            Page = CurrentPage,
            PageSize = 10
        };

        var (items, total) = await AuthApi.SearchVacanciesAsync(dto);
        VacancyList = items;
        TotalResults = total;
    }

    private string GetContractTypeLabel(int type) => type switch
    {
        0 => Lang.T("common.contract.fullTime"),
        1 => Lang.T("common.contract.partTime"),
        2 => Lang.T("common.contract.contract"),
        3 => Lang.T("common.contract.remote"),
        _ => ""
    };
}
