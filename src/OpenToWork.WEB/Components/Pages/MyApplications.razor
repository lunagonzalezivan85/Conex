@page "/my-applications"
@using OpenToWork.Shared.DTOs
@using OpenToWork.WEB.Services
@inject ApiAuthService AuthApi
@inject LanguageService Lang

<PageTitle>@Lang.T("applications.myTitle")</PageTitle>

<div class="page-container">
    <h1 class="mb-lg">@Lang.T("applications.myTitle")</h1>

    @if (IsLoading)
    {
        <p>@Lang.T("common.labels.loading")</p>
    }
    else if (!Applications.Any())
    {
        <div class="ot-card text-center">
            <p class="auth-subtitle">@Lang.T("applications.noMyApplications")</p>
        </div>
    }
    else
    {
        <div class="bento-grid">
            @foreach (var app in Applications)
            {
                <div class="vacancy-card">
                    <div class="vacancy-card-title">@app.VacancyTitle</div>
                    <div class="vacancy-card-location">@(app.CompanyName ?? "")</div>
                    @if (app.ExpectedSalary.HasValue)
                    {
                        <div class="vacancy-card-salary">$@app.ExpectedSalary.Value.ToString("N0")</div>
                    }
                    <div class="vacancy-card-footer">
                        <span class="vacancy-card-badge @GetStatusClass(app.Status)">@GetStatusLabel(app.Status)</span>
                    </div>
                    <div style="margin-top: 0.5rem; font-size: 0.8rem; color: var(--text-muted);">
                        @app.CreatedAt.ToString("MMM dd, yyyy")
                    </div>
                    <a href="/vacancy/@app.VacancyId" class="ot-btn ot-btn--secondary ot-btn--small mt-md">@Lang.T("common.buttons.view")</a>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<ApplicationDto> Applications { get; set; } = new();
    private bool IsLoading { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();
        await LoadApplications();
    }

    private async Task LoadApplications()
    {
        IsLoading = true;
        Applications = await AuthApi.GetMyApplicationsAsync();
        IsLoading = false;
    }

    private string GetStatusLabel(int status) => status switch
    {
        0 => Lang.T("applications.status.pending"),
        1 => Lang.T("applications.status.inReview"),
        2 => Lang.T("applications.status.accepted"),
        3 => Lang.T("applications.status.rejected"),
        _ => ""
    };

    private string GetStatusClass(int status) => status switch
    {
        0 => "badge-draft",
        1 => "badge-active",
        2 => "badge-active",
        3 => "badge-closed",
        _ => ""
    };
}
