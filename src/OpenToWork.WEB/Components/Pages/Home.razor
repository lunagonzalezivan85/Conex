@page "/"
@using OpenToWork.WEB.Services
@inject LanguageService Lang
@inject NavigationManager Nav

<PageTitle>OpenToWork</PageTitle>

<div class="home-hero">
    <div class="home-hero-content">
        <h1 class="home-hero-title">@Lang.T("common.home.heroTitle")</h1>
        <p class="home-hero-subtitle">@Lang.T("common.home.heroSubtitle")</p>

        <div class="home-search-bar">
            <div class="home-search-field home-search-field--keyword">
                <span class="home-search-icon">🔍</span>
                <input type="text" @bind="SearchKeyword" placeholder="@Lang.T("common.search.placeholder")" class="home-search-input" />
            </div>
            <div class="home-search-field home-search-field--location">
                <span class="home-search-icon">📍</span>
                <input type="text" @bind="SearchLocation" placeholder="@Lang.T("common.search.locationPlaceholder")" class="home-search-input" />
            </div>
            <div class="home-search-field home-search-field--category">
                <select @bind="SearchCategory" class="home-search-select">
                    <option value="">@Lang.T("common.search.allCategories")</option>
                    <option value="it">@Lang.T("common.nav.categoryIT")</option>
                    <option value="finance">@Lang.T("common.nav.categoryFinance")</option>
                    <option value="health">@Lang.T("common.nav.categoryHealth")</option>
                    <option value="education">@Lang.T("common.nav.categoryEducation")</option>
                    <option value="marketing">@Lang.T("common.nav.categoryMarketing")</option>
                    <option value="engineering">@Lang.T("common.nav.categoryEngineering")</option>
                    <option value="sales">@Lang.T("common.nav.categorySales")</option>
                    <option value="design">@Lang.T("common.nav.categoryDesign")</option>
                </select>
            </div>
            <button class="ot-btn ot-btn--primary ot-btn--large" @onclick="HandleSearch">
                @Lang.T("common.search.button")
            </button>
        </div>

        <div class="home-search-popular">
            <span class="home-search-popular-label">@Lang.T("common.search.popular"):</span>
            <a href="/vacancies?keyword=developer" class="home-search-tag">Developer</a>
            <a href="/vacancies?keyword=designer" class="home-search-tag">Designer</a>
            <a href="/vacancies?keyword=manager" class="home-search-tag">Manager</a>
            <a href="/vacancies?keyword=analyst" class="home-search-tag">Analyst</a>
        </div>
    </div>
</div>

<div class="page-container">
    <div class="role-selector">
        <div class="role-card" @onclick="() => GoToRegister(0)">
            <div class="role-card-icon">🔍</div>
            <div class="role-card-title">@Lang.T("common.roles.searchJob")</div>
            <div class="role-card-desc">@Lang.T("common.roles.searchJobDesc")</div>
        </div>
        <div class="role-card" @onclick="() => GoToRegister(1)">
            <div class="role-card-icon">💼</div>
            <div class="role-card-title">@Lang.T("common.roles.createVacancy")</div>
            <div class="role-card-desc">@Lang.T("common.roles.createVacancyDesc")</div>
        </div>
    </div>
</div>

@code {
    private string SearchKeyword { get; set; } = string.Empty;
    private string SearchLocation { get; set; } = string.Empty;
    private string SearchCategory { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();
    }

    private void HandleSearch()
    {
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(SearchKeyword))
            query.Add($"keyword={Uri.EscapeDataString(SearchKeyword)}");
        if (!string.IsNullOrWhiteSpace(SearchLocation))
            query.Add($"location={Uri.EscapeDataString(SearchLocation)}");
        if (!string.IsNullOrWhiteSpace(SearchCategory))
            query.Add($"category={SearchCategory}");
        var qs = query.Count > 0 ? "?" + string.Join("&", query) : "";
        Nav.NavigateTo($"/vacancies{qs}");
    }

    private void GoToRegister(int role)
    {
        Nav.NavigateTo($"/register?role={role}");
    }
}
