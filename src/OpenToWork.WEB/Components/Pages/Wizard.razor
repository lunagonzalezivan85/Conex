@page "/wizard"
@using OpenToWork.Shared.DTOs
@using OpenToWork.WEB.Services
@inject ApiAuthService AuthApi
@inject LanguageService Lang
@inject NavigationManager Nav

<PageTitle>@Lang.T("wizard.title")</PageTitle>

<div class="wizard-container">
    <h2 class="text-center mb-lg">@Lang.T("wizard.title")</h2>

    <div class="wizard-progress">
        <div class="wizard-progress-bar" style="width: @GetProgressPercent()%"></div>
    </div>

    <div class="wizard-step-indicator">
        @for (int i = 1; i <= TotalSteps; i++)
        {
            <div class="wizard-step-dot @(i == CurrentStep ? "active" : "") @(i < CurrentStep ? "completed" : "")">
                @(i < CurrentStep ? "✓" : i.ToString())
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-error">@ErrorMessage</div>
    }

    <div class="ot-card">
        @switch (CurrentStep)
        {
            case 1:
                <h3>@Lang.T("wizard.steps.personalData.title")</h3>
                <p class="auth-subtitle">@Lang.T("wizard.steps.personalData.description")</p>
                <div class="ot-input-group mb-md">
                    <label class="ot-input-label">@Lang.T("common.labels.firstName")</label>
                    <input class="ot-input-field" @bind="WizardData.FirstName" />
                </div>
                <div class="ot-input-group mb-md">
                    <label class="ot-input-label">@Lang.T("common.labels.lastName")</label>
                    <input class="ot-input-field" @bind="WizardData.LastName" />
                </div>
                <div class="ot-input-group mb-md">
                    <label class="ot-input-label">@Lang.T("common.labels.identification")</label>
                    <input class="ot-input-field" @bind="WizardData.Identification" />
                </div>
                <div class="ot-input-group mb-md">
                    <label class="ot-input-label">@Lang.T("common.labels.phone")</label>
                    <input class="ot-input-field" @bind="WizardData.Phone" />
                </div>
                <div class="ot-input-group mb-md">
                    <label class="ot-input-label">@Lang.T("common.labels.birthDate")</label>
                    <input type="date" class="ot-input-field" @bind="WizardData.BirthDate" />
                </div>
                <div class="ot-input-group mb-md">
                    <label class="ot-input-label">@Lang.T("common.labels.gender")</label>
                    <select class="ot-input-field" @bind="WizardData.Gender">
                        <option value="">--</option>
                        <option value="0">@Lang.T("common.gender.male")</option>
                        <option value="1">@Lang.T("common.gender.female")</option>
                        <option value="2">@Lang.T("common.gender.other")</option>
                        <option value="3">@Lang.T("common.gender.preferNotToSay")</option>
                    </select>
                </div>
                break;

            case 2:
                <h3>@Lang.T("wizard.steps.location.title")</h3>
                <p class="auth-subtitle">@Lang.T("wizard.steps.location.description")</p>
                <div class="ot-input-group mb-md">
                    <label class="ot-input-label">@Lang.T("common.labels.country")</label>
                    <input class="ot-input-field" @bind="WizardData.Country" />
                </div>
                <div class="ot-input-group mb-md">
                    <label class="ot-input-label">@Lang.T("common.labels.city")</label>
                    <input class="ot-input-field" @bind="WizardData.City" />
                </div>
                <div class="ot-input-group mb-md">
                    <label class="ot-input-label">@Lang.T("common.labels.address")</label>
                    <input class="ot-input-field" @bind="WizardData.Address" />
                </div>
                break;

            case 3:
                <h3>@Lang.T("wizard.steps.professionalProfile.title")</h3>
                <p class="auth-subtitle">@Lang.T("wizard.steps.professionalProfile.description")</p>
                <div class="ot-input-group mb-md">
                    <label class="ot-input-label">@Lang.T("common.labels.title")</label>
                    <input class="ot-input-field" @bind="WizardData.Title" placeholder="ej: Desarrollador Full Stack" />
                </div>
                <div class="ot-input-group mb-md">
                    <label class="ot-input-label">@Lang.T("common.labels.summary")</label>
                    <textarea class="ot-input-field" rows="4" @bind="WizardData.Summary"></textarea>
                </div>
                break;

            case 4:
                <h3>@Lang.T("wizard.steps.skills.title")</h3>
                <p class="auth-subtitle">@Lang.T("wizard.steps.skills.description")</p>
                <p class="auth-subtitle">Selecciona tus habilidades (opcional)</p>
                break;

            case 5:
                <h3>@Lang.T("wizard.steps.preferences.title")</h3>
                <p class="auth-subtitle">@Lang.T("wizard.steps.preferences.description")</p>
                <div class="role-selector">
                    <div class="role-card selected">
                        <div class="role-card-icon">🔍</div>
                        <div class="role-card-title">@Lang.T("common.roles.searchJob")</div>
                    </div>
                    <div class="role-card">
                        <div class="role-card-icon">💼</div>
                        <div class="role-card-title">@Lang.T("common.roles.createVacancy")</div>
                    </div>
                </div>
                break;

            case 6:
                <h3>@Lang.T("wizard.steps.confirmation.title")</h3>
                <p class="auth-subtitle">@Lang.T("wizard.steps.confirmation.description")</p>
                <div class="ot-card" style="background: var(--bg-tertiary);">
                    <p><strong>@Lang.T("common.labels.firstName"):</strong> @WizardData.FirstName</p>
                    <p><strong>@Lang.T("common.labels.lastName"):</strong> @WizardData.LastName</p>
                    <p><strong>@Lang.T("common.labels.email"):</strong> @WizardData.Email</p>
                    <p><strong>@Lang.T("common.labels.city"):</strong> @WizardData.City</p>
                    <p><strong>@Lang.T("common.labels.title"):</strong> @WizardData.Title</p>
                </div>
                break;

            case 7:
                <h3>@Lang.T("wizard.steps.workExperience.title")</h3>
                <p class="auth-subtitle">@Lang.T("wizard.steps.workExperience.description")</p>
                <div class="ot-input-group mb-md">
                    <label class="ot-input-label">@Lang.T("profile.experience.company")</label>
                    <input class="ot-input-field" @bind="NewExp.CompanyName" />
                </div>
                <div class="ot-input-group mb-md">
                    <label class="ot-input-label">@Lang.T("profile.experience.jobTitle")</label>
                    <input class="ot-input-field" @bind="NewExp.JobTitle" />
                </div>
                <div class="ot-input-group mb-md">
                    <label class="ot-input-label">@Lang.T("profile.experience.location")</label>
                    <input class="ot-input-field" @bind="NewExp.Location" />
                </div>
                <div class="flex gap-sm mb-md">
                    <div class="ot-input-group">
                        <label class="ot-input-label">@Lang.T("common.labels.startDate")</label>
                        <input type="date" class="ot-input-field" @bind="NewExp.StartDate" />
                    </div>
                    <div class="ot-input-group">
                        <label class="ot-input-label">@Lang.T("common.labels.endDate")</label>
                        <input type="date" class="ot-input-field" @bind="NewExp.EndDate" />
                    </div>
                </div>
                <div class="ot-input-group mb-md">
                    <label class="flex-center gap-sm">
                        <input type="checkbox" @bind="NewExp.IsCurrentJob" />
                        @Lang.T("profile.experience.current")
                    </label>
                </div>
                <button class="ot-btn ot-btn--secondary ot-btn--small" @onclick="AddExperienceToWizard">@Lang.T("common.buttons.add")</button>
                @if (WizardExperiences.Any())
                {
                    <div class="mt-md">
                        @foreach (var exp in WizardExperiences)
                        {
                            <div class="ot-card mb-sm" style="background: var(--bg-tertiary);">
                                <strong>@exp.JobTitle</strong> - @exp.CompanyName
                            </div>
                        }
                    </div>
                }
                break;

            case 8:
                <h3>@Lang.T("wizard.steps.education.title")</h3>
                <p class="auth-subtitle">@Lang.T("wizard.steps.education.description")</p>
                <div class="ot-input-group mb-md">
                    <label class="ot-input-label">@Lang.T("profile.education.institution")</label>
                    <input class="ot-input-field" @bind="NewEdu.Institution" />
                </div>
                <div class="ot-input-group mb-md">
                    <label class="ot-input-label">@Lang.T("profile.education.degree")</label>
                    <input class="ot-input-field" @bind="NewEdu.Degree" />
                </div>
                <div class="ot-input-group mb-md">
                    <label class="ot-input-label">@Lang.T("profile.education.fieldOfStudy")</label>
                    <input class="ot-input-field" @bind="NewEdu.FieldOfStudy" />
                </div>
                <div class="flex gap-sm mb-md">
                    <div class="ot-input-group">
                        <label class="ot-input-label">@Lang.T("common.labels.startDate")</label>
                        <input type="date" class="ot-input-field" @bind="NewEdu.StartDate" />
                    </div>
                    <div class="ot-input-group">
                        <label class="ot-input-label">@Lang.T("common.labels.endDate")</label>
                        <input type="date" class="ot-input-field" @bind="NewEdu.EndDate" />
                    </div>
                </div>
                <div class="ot-input-group mb-md">
                    <label class="flex-center gap-sm">
                        <input type="checkbox" @bind="NewEdu.IsInProgress" />
                        @Lang.T("profile.education.inProgress")
                    </label>
                </div>
                <button class="ot-btn ot-btn--secondary ot-btn--small" @onclick="AddEducationToWizard">@Lang.T("common.buttons.add")</button>
                @if (WizardEducations.Any())
                {
                    <div class="mt-md">
                        @foreach (var edu in WizardEducations)
                        {
                            <div class="ot-card mb-sm" style="background: var(--bg-tertiary);">
                                <strong>@edu.Degree</strong> - @edu.Institution
                            </div>
                        }
                    </div>
                }
                break;

            case 9:
                <h3>@Lang.T("wizard.steps.certifications.title")</h3>
                <p class="auth-subtitle">@Lang.T("wizard.steps.certifications.description")</p>
                <div class="ot-input-group mb-md">
                    <label class="ot-input-label">@Lang.T("profile.certification.name")</label>
                    <input class="ot-input-field" @bind="NewCert.Name" />
                </div>
                <div class="ot-input-group mb-md">
                    <label class="ot-input-label">@Lang.T("profile.certification.issuer")</label>
                    <input class="ot-input-field" @bind="NewCert.Issuer" />
                </div>
                <div class="flex gap-sm mb-md">
                    <div class="ot-input-group">
                        <label class="ot-input-label">@Lang.T("common.labels.issueDate")</label>
                        <input type="date" class="ot-input-field" @bind="NewCert.IssueDate" />
                    </div>
                    <div class="ot-input-group">
                        <label class="ot-input-label">@Lang.T("common.labels.expiryDate")</label>
                        <input type="date" class="ot-input-field" @bind="NewCert.ExpiryDate" />
                    </div>
                </div>
                <button class="ot-btn ot-btn--secondary ot-btn--small" @onclick="AddCertificationToWizard">@Lang.T("common.buttons.add")</button>
                @if (WizardCertifications.Any())
                {
                    <div class="mt-md">
                        @foreach (var cert in WizardCertifications)
                        {
                            <div class="ot-card mb-sm" style="background: var(--bg-tertiary);">
                                <strong>@cert.Name</strong> @(cert.Issuer != null ? $" - {cert.Issuer}" : "")
                            </div>
                        }
                    </div>
                }
                break;

            case 10:
                <h3>@Lang.T("wizard.steps.uploadCv.title")</h3>
                <p class="auth-subtitle">@Lang.T("wizard.steps.uploadCv.description")</p>
                <div class="ot-input-group mb-md">
                    <label class="ot-input-label">@Lang.T("profile.fields.cvUrl")</label>
                    <input class="ot-input-field" @bind="WizardData.CvUrl" placeholder="https://..." />
                </div>
                <p class="auth-subtitle">@Lang.T("wizard.steps.uploadCv.optional")</p>
                break;
        }
    </div>

    <div class="wizard-actions">
        <button class="ot-btn ot-btn--secondary ot-btn--medium" disabled="@(CurrentStep <= 1 || IsLoading)" @onclick="PreviousStep">
            @Lang.T("wizard.buttons.previous")
        </button>
        @if (CurrentStep < TotalSteps)
        {
            <button class="ot-btn ot-btn--primary ot-btn--medium" disabled="@IsLoading" @onclick="NextStep">
                @Lang.T("wizard.buttons.next")
            </button>
        }
        else
        {
            <button class="ot-btn ot-btn--primary ot-btn--medium" disabled="@IsLoading" @onclick="CompleteWizard">
                @Lang.T("wizard.buttons.complete")
            </button>
        }
        @if (CurrentStep > 6 && CurrentStep < TotalSteps)
        {
            <button class="ot-btn ot-btn--secondary ot-btn--medium" @onclick="SkipOptionalStep">
                @Lang.T("wizard.buttons.skip")
            </button>
        }
    </div>
</div>

@code {
    private int CurrentStep { get; set; } = 1;
    private const int TotalSteps = 10;
    private bool IsLoading { get; set; }
    private string? ErrorMessage { get; set; }
    private WizardFormData WizardData { get; set; } = new();
    private CreateExperienceDto NewExp { get; set; } = new();
    private CreateEducationDto NewEdu { get; set; } = new();
    private CreateCertificationDto NewCert { get; set; } = new();
    private List<CandidateExperienceDto> WizardExperiences { get; set; } = new();
    private List<CandidateEducationDto> WizardEducations { get; set; } = new();
    private List<CandidateCertificationDto> WizardCertifications { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();

        var profile = await AuthApi.GetCandidateProfileAsync();
        if (profile != null)
        {
            WizardData.FirstName = profile.FirstName;
            WizardData.LastName = profile.LastName;
            WizardData.Identification = profile.Identification;
            WizardData.Phone = profile.Phone;
            WizardData.BirthDate = profile.BirthDate;
            WizardData.Gender = profile.Gender?.ToString();
            WizardData.Title = profile.Title;
            WizardData.Summary = profile.Summary;
            WizardData.Country = profile.Country;
            WizardData.City = profile.City;
            WizardData.Address = profile.Address;

            if (profile.WizardStep > 0 && !profile.WizardCompleted)
                CurrentStep = profile.WizardStep;
        }
    }

    private int GetProgressPercent() => (int)((double)CurrentStep / TotalSteps * 100);

    private async Task NextStep()
    {
        IsLoading = true;
        try
        {
            await SaveWizardStep(CurrentStep + 1, false);
            CurrentStep++;
        }
        catch
        {
            ErrorMessage = Lang.T("errors.generic");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void PreviousStep()
    {
        if (CurrentStep > 1) CurrentStep--;
    }

    private async Task CompleteWizard()
    {
        IsLoading = true;
        try
        {
            await SaveWizardStep(TotalSteps, true);
            Nav.NavigateTo("/dashboard");
        }
        catch
        {
            ErrorMessage = Lang.T("errors.generic");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SaveWizardStep(int step, bool completed)
    {
        var dto = new UpdateCandidateWizardDto
        {
            FirstName = WizardData.FirstName,
            LastName = WizardData.LastName,
            Identification = WizardData.Identification,
            Phone = WizardData.Phone,
            BirthDate = WizardData.BirthDate,
            Gender = int.TryParse(WizardData.Gender, out var g) ? g : null,
            Title = WizardData.Title,
            Summary = WizardData.Summary,
            Country = WizardData.Country,
            City = WizardData.City,
            Address = WizardData.Address,
            WizardStep = step,
            WizardCompleted = completed
        };

        await AuthApi.UpdateWizardStepAsync(dto);

        if (completed && !string.IsNullOrEmpty(WizardData.CvUrl))
        {
            await AuthApi.UpdateProfileAsync(new UpdateCandidateProfileDto { CvUrl = WizardData.CvUrl });
        }
    }

    private async Task AddExperienceToWizard()
    {
        var result = await AuthApi.AddExperienceAsync(NewExp);
        if (result != null)
        {
            WizardExperiences.Add(result);
            NewExp = new CreateExperienceDto();
        }
    }

    private async Task AddEducationToWizard()
    {
        var result = await AuthApi.AddEducationAsync(NewEdu);
        if (result != null)
        {
            WizardEducations.Add(result);
            NewEdu = new CreateEducationDto();
        }
    }

    private async Task AddCertificationToWizard()
    {
        var result = await AuthApi.AddCertificationAsync(NewCert);
        if (result != null)
        {
            WizardCertifications.Add(result);
            NewCert = new CreateCertificationDto();
        }
    }

    private async Task SkipOptionalStep()
    {
        await NextStep();
    }

    public class WizardFormData
    {
        public string Email { get; set; } = "";
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string? Identification { get; set; }
        public string? Phone { get; set; }
        public DateTime? BirthDate { get; set; }
        public string? Gender { get; set; }
        public string? Title { get; set; }
        public string? Summary { get; set; }
        public string? Country { get; set; }
        public string? City { get; set; }
        public string? Address { get; set; }
        public string? CvUrl { get; set; }
    }
}
