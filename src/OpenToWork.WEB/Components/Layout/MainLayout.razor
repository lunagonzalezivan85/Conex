@inherits LayoutComponentBase
@using OpenToWork.WEB.Services
@inject LanguageService Lang
@inject Microsoft.JSInterop.IJSRuntime JS

<div class="app-layout">
    <header class="nav-header">
        <nav class="nav-bar">
            <div class="nav-brand">
                <a href="/">
                    <span class="nav-brand-logo">OTW</span>
                    <span class="nav-brand-text">OpenToWork</span>
                </a>
            </div>
            <div class="nav-links">
                <a href="/" class="nav-link">@Lang.T("common.nav.home")</a>
                <a href="/about" class="nav-link">@Lang.T("common.nav.about")</a>
            </div>
            <div class="nav-actions">
                <select @onchange="OnThemeChanged" class="nav-select">
                    <option value="navy">Navy</option>
                    <option value="dark">Dark</option>
                    <option value="light">Light</option>
                </select>
                <select @onchange="OnLanguageChanged" class="nav-select">
                    <option value="es">ES</option>
                    <option value="en">EN</option>
                </select>
                <a href="/login" class="ot-btn ot-btn--ghost ot-btn--small">@Lang.T("common.buttons.login")</a>
                <a href="/register" class="ot-btn ot-btn--primary ot-btn--small">@Lang.T("common.buttons.register")</a>
            </div>
        </nav>
        <nav class="nav-categories">
            <a href="/vacancies?category=it" class="nav-category-link">@Lang.T("common.nav.categoryIT")</a>
            <a href="/vacancies?category=finance" class="nav-category-link">@Lang.T("common.nav.categoryFinance")</a>
            <a href="/vacancies?category=health" class="nav-category-link">@Lang.T("common.nav.categoryHealth")</a>
            <a href="/vacancies?category=education" class="nav-category-link">@Lang.T("common.nav.categoryEducation")</a>
            <a href="/vacancies?category=marketing" class="nav-category-link">@Lang.T("common.nav.categoryMarketing")</a>
            <a href="/vacancies?category=engineering" class="nav-category-link">@Lang.T("common.nav.categoryEngineering")</a>
            <a href="/vacancies?category=sales" class="nav-category-link">@Lang.T("common.nav.categorySales")</a>
            <a href="/vacancies?category=design" class="nav-category-link">@Lang.T("common.nav.categoryDesign")</a>
        </nav>
    </header>

    <main class="main-content">
        @Body
    </main>

    <section class="footer-vacancies-strip">
        <div class="footer-vacancies-strip-header">
            <h3 class="footer-vacancies-strip-title">@Lang.T("common.home.featuredVacancies")</h3>
            <a href="/vacancies" class="footer-vacancies-strip-link">@Lang.T("common.home.viewAllVacancies") →</a>
        </div>
        <div class="footer-vacancies-strip-track">
            <div class="footer-vacancy-chip">
                <span class="footer-vacancy-chip-title">Senior React Developer</span>
                <span class="footer-vacancy-chip-meta">Remoto · $5,000/mes</span>
            </div>
            <div class="footer-vacancy-chip">
                <span class="footer-vacancy-chip-title">UX Designer</span>
                <span class="footer-vacancy-chip-meta">Bogotá · $3,200/mes</span>
            </div>
            <div class="footer-vacancy-chip">
                <span class="footer-vacancy-chip-title">Backend Engineer (Node.js)</span>
                <span class="footer-vacancy-chip-meta">Medellín · $4,500/mes</span>
            </div>
            <div class="footer-vacancy-chip">
                <span class="footer-vacancy-chip-title">Data Analyst</span>
                <span class="footer-vacancy-chip-meta">Remoto · $3,800/mes</span>
            </div>
            <div class="footer-vacancy-chip">
                <span class="footer-vacancy-chip-title">Marketing Manager</span>
                <span class="footer-vacancy-chip-meta">Cali · $4,000/mes</span>
            </div>
            <div class="footer-vacancy-chip">
                <span class="footer-vacancy-chip-title">DevOps Engineer</span>
                <span class="footer-vacancy-chip-meta">Remoto · $5,500/mes</span>
            </div>
            <div class="footer-vacancy-chip">
                <span class="footer-vacancy-chip-title">Product Manager</span>
                <span class="footer-vacancy-chip-meta">Barranquilla · $6,000/mes</span>
            </div>
            <div class="footer-vacancy-chip">
                <span class="footer-vacancy-chip-title">Mobile Developer (Flutter)</span>
                <span class="footer-vacancy-chip-meta">Remoto · $4,200/mes</span>
            </div>
        </div>
    </section>

    <footer class="site-footer">
        <div class="footer-container">
            <div class="footer-col footer-col--brand">
                <div class="footer-brand">
                    <span class="footer-brand-logo">OTW</span>
                    <span class="footer-brand-text">OpenToWork</span>
                </div>
                <p class="footer-brand-desc">@Lang.T("common.home.heroSubtitle")</p>
            </div>
            <div class="footer-col">
                <h4 class="footer-title">@Lang.T("common.footer.menu")</h4>
                <a href="/" class="footer-link">@Lang.T("common.nav.home")</a>
                <a href="/vacancies" class="footer-link">@Lang.T("common.nav.vacancies")</a>
                <a href="/dashboard" class="footer-link">@Lang.T("common.nav.dashboard")</a>
            </div>
            <div class="footer-col">
                <h4 class="footer-title">@Lang.T("common.footer.about")</h4>
                <a href="/about" class="footer-link">@Lang.T("common.nav.about")</a>
                <a href="/faq" class="footer-link">@Lang.T("common.footer.faq")</a>
                <a href="/terms" class="footer-link">@Lang.T("common.footer.terms")</a>
                <a href="/privacy" class="footer-link">@Lang.T("common.footer.privacy")</a>
            </div>
            <div class="footer-col">
                <h4 class="footer-title">@Lang.T("common.footer.contact")</h4>
                <a href="mailto:contacto@opentowork.com" class="footer-link">contacto@opentowork.com</a>
                <a href="tel:+5712345678" class="footer-link">+57 123 456 78</a>
            </div>
            <div class="footer-col">
                <h4 class="footer-title">@Lang.T("common.footer.followUs")</h4>
                <div class="footer-social">
                    <a href="#" class="footer-social-link" aria-label="LinkedIn">in</a>
                    <a href="#" class="footer-social-link" aria-label="Twitter">X</a>
                    <a href="#" class="footer-social-link" aria-label="Instagram">IG</a>
                    <a href="#" class="footer-social-link" aria-label="Facebook">f</a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <span>&copy; @DateTime.Now.Year OpenToWork. @Lang.T("common.footer.rights")</span>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">X</span>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();
    }

    private async Task OnThemeChanged(ChangeEventArgs e)
    {
        if (e.Value is string theme)
        {
            await JS.InvokeVoidAsync("themeSwitcher.set", theme);
        }
    }

    private async Task OnLanguageChanged(ChangeEventArgs e)
    {
        if (e.Value is string lang)
        {
            await Lang.SetLanguageAsync(lang);
        }
    }
}
