@inherits LayoutComponentBase
@using OpenToWork.WEB.Services
@inject LanguageService Lang
@inject Microsoft.JSInterop.IJSRuntime JS

<div class="app-layout">
    <header class="nav-header">
        <nav class="nav-bar">
            <div class="nav-brand">
                <a href="/">
                    <span class="nav-brand-logo">OTW</span>
                    <span class="nav-brand-text">OpenToWork</span>
                </a>
            </div>
            <div class="nav-links">
                <a href="/" class="nav-link">@Lang.T("common.nav.home")</a>
                <a href="/about" class="nav-link">@Lang.T("common.nav.about")</a>
            </div>
            <div class="nav-actions">
                <select @onchange="OnThemeChanged" class="nav-select">
                    <option value="navy">Navy</option>
                    <option value="dark">Dark</option>
                    <option value="light">Light</option>
                </select>
                <select @onchange="OnLanguageChanged" class="nav-select">
                    <option value="es">ES</option>
                    <option value="en">EN</option>
                </select>
                <a href="/login" class="ot-btn ot-btn--ghost ot-btn--small">@Lang.T("common.buttons.login")</a>
                <a href="/register" class="ot-btn ot-btn--primary ot-btn--small">@Lang.T("common.buttons.register")</a>
            </div>
        </nav>
        <nav class="nav-categories">
            <a href="/vacancies?category=it" class="nav-category-link">@Lang.T("common.nav.categoryIT")</a>
            <a href="/vacancies?category=finance" class="nav-category-link">@Lang.T("common.nav.categoryFinance")</a>
            <a href="/vacancies?category=health" class="nav-category-link">@Lang.T("common.nav.categoryHealth")</a>
            <a href="/vacancies?category=education" class="nav-category-link">@Lang.T("common.nav.categoryEducation")</a>
            <a href="/vacancies?category=marketing" class="nav-category-link">@Lang.T("common.nav.categoryMarketing")</a>
            <a href="/vacancies?category=engineering" class="nav-category-link">@Lang.T("common.nav.categoryEngineering")</a>
            <a href="/vacancies?category=sales" class="nav-category-link">@Lang.T("common.nav.categorySales")</a>
            <a href="/vacancies?category=design" class="nav-category-link">@Lang.T("common.nav.categoryDesign")</a>
        </nav>
    </header>

    <main class="main-content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">X</span>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        if (Lang._translations.Count == 0)
            await Lang.InitializeAsync();
    }

    private async Task OnThemeChanged(ChangeEventArgs e)
    {
        if (e.Value is string theme)
        {
            await JS.InvokeVoidAsync("themeSwitcher.set", theme);
        }
    }

    private async Task OnLanguageChanged(ChangeEventArgs e)
    {
        if (e.Value is string lang)
        {
            await Lang.SetLanguageAsync(lang);
        }
    }
}
